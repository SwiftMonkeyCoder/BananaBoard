# Use a generated random value with at least 32 characters in production.
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://bananaboard:bananaboard@db:5432/bananaboard
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
PORT=3000
UPLOAD_DIR=/app/data/uploads
NODE_ENV=development

# PostgreSQL container values. Use different strong secrets for production.
POSTGRES_DB=bananaboard
POSTGRES_USER=bananaboard
POSTGRES_PASSWORD=bananaboard
